{
  "name": "react-pointing-bubble",
  "version": "0.5.2",
  "description": "React callout / speech bubble whose SVG tail points exactly at coordinates or a DOM element.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/react-pointing-bubble.cjs",
  "module": "./dist/react-pointing-bubble.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-pointing-bubble.js",
      "require": "./dist/react-pointing-bubble.cjs"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.2",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://murznn.github.io/js-pointing-bubble/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurzNN/js-pointing-bubble.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "callout",
    "speech-bubble",
    "tooltip",
    "popover",
    "shadcn"
  ]
}
