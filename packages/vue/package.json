{
  "name": "vue-pointing-bubble",
  "version": "0.5.1",
  "description": "Vue 3 callout / speech bubble whose SVG tail points exactly at coordinates or a DOM element.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/vue-pointing-bubble.cjs",
  "module": "./dist/vue-pointing-bubble.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-pointing-bubble.js",
      "require": "./dist/vue-pointing-bubble.cjs"
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.7"
  },
  "license": "MIT",
  "homepage": "https://murznn.github.io/js-pointing-bubble/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurzNN/js-pointing-bubble.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "vue3",
    "callout",
    "speech-bubble",
    "tooltip",
    "popover",
    "shadcn-vue"
  ]
}
